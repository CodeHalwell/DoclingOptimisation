# syntax=docker/dockerfile:1
# Azure Container App CPU-optimised build
# Target: Consumption plan — 4 vCPUs, 8 Gi memory, x86-64 (Intel/AMD)
#
# Optimisations over the base Dockerfile:
#   - Platform pinned to linux/amd64 (Azure runs x86-64)
#   - Python 3.12 (stable, full ONNX Runtime compatibility)
#   - tcmalloc via LD_PRELOAD (reduces malloc contention)
#   - OneDNN AVX-512 ISA enabled (Intel Xeon acceleration)
#   - Thread count defaulted to 4 (matches 4 vCPU allocation)
#   - Batch sizes tuned for 8 Gi memory ceiling

FROM --platform=linux/amd64 python:3.12-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gcc g++ libgl1-mesa-dev libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ARG UV_INSTALLER_VERSION=0.10.4
ARG UV_INSTALLER_SHA256=169fd7c68bdd40f80ab25635b1e10adfc8cef58b4935017e8560c87639d4544c
ADD https://astral.sh/uv/${UV_INSTALLER_VERSION}/install.sh /uv-installer.sh
RUN echo "${UV_INSTALLER_SHA256}  /uv-installer.sh" | sha256sum -c - \
    && sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin:$PATH"

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /build

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache-cpu \
    uv sync --frozen --no-dev

# Pre-fetch models so containers start without network access.
ENV PATH="/build/.venv/bin:$PATH"
RUN docling-tools models download

RUN uv run --frozen python -c \
    "from huggingface_hub import snapshot_download; snapshot_download('docling-project/docling-layout-egret-medium')"
RUN uv run --frozen python -c \
    "from huggingface_hub import snapshot_download; snapshot_download('ibm-granite/granite-docling-258M')"
RUN uv run --frozen python -c \
    "from huggingface_hub import snapshot_download; snapshot_download('HuggingFaceTB/SmolVLM-256M-Instruct')"

# Pre-download RapidOCR torch models
RUN <<'PYEOF'
uv run --frozen python -c "
from pathlib import Path
import importlib.resources, urllib.request

models_dir = Path(importlib.resources.files('rapidocr')) / 'models'
models_dir.mkdir(exist_ok=True)

base = 'https://www.modelscope.cn/models/RapidAI/RapidOCR/resolve/v3.6.0/torch/PP-OCRv4'
files = [
    ('det', 'ch_PP-OCRv4_det_infer.pth'),
    ('cls', 'ch_ptocr_mobile_v2.0_cls_infer.pth'),
    ('rec', 'ch_PP-OCRv4_rec_infer.pth'),
]
for sub, name in files:
    dest = models_dir / name
    if not dest.exists():
        url = f'{base}/{sub}/{name}'
        print(f'Downloading {name} from {url}...')
        urllib.request.urlretrieve(url, dest)
        print(f'  Saved to {dest} ({dest.stat().st_size / 1024:.0f} KB)')

keys_url = 'https://www.modelscope.cn/models/RapidAI/RapidOCR/resolve/v3.6.0/torch/PP-OCRv4/rec/ppocr_keys_v1.txt'
keys_dest = models_dir / 'ppocr_keys_v1.txt'
if not keys_dest.exists():
    print('Downloading ppocr_keys_v1.txt...')
    urllib.request.urlretrieve(keys_url, keys_dest)

print('RapidOCR models pre-downloaded successfully')
"
PYEOF

# ---------------------------------------------------------------------
FROM --platform=linux/amd64 python:3.12-slim-bookworm AS runtime

RUN groupadd -r docling && useradd -r -g docling -d /home/docling -m docling
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 libgoogle-perftools4 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder --chown=docling:docling /build/.venv /home/docling/.venv
COPY --from=builder --chown=docling:docling /root/.cache /home/docling/.cache
COPY --from=builder /root/.local/bin/uv /usr/local/bin/uv
COPY --from=builder /root/.local/bin/uvx /usr/local/bin/uvx

# x86-64 Azure CPU-specific tuning:
#   LD_PRELOAD=tcmalloc — reduces malloc lock contention across 4 threads
#   ONEDNN_MAX_CPU_ISA  — enables AVX-512 + AMX on Intel Xeon (Azure D/E-series)
#   DOCLING_NUM_THREADS — matches the 4 vCPU allocation
#   MALLOC_ARENA_MAX    — limits glibc arena count to reduce RSS overhead
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/home/docling/.cache/huggingface \
    HF_HUB_ETAG_TIMEOUT=0 \
    HF_HUB_DOWNLOAD_TIMEOUT=5 \
    MALLOC_ARENA_MAX=2 \
    PATH="/home/docling/.venv/bin:$PATH" \
    VIRTUAL_ENV=/home/docling/.venv \
    LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc.so.4 \
    ONEDNN_MAX_CPU_ISA=AVX512_CORE_AMX \
    DOCLING_NUM_THREADS=4 \
    DOCLING_DEVICE=cpu

USER docling
WORKDIR /home/docling
COPY --chown=docling:docling pyproject.toml uv.lock ./
COPY --chown=docling:docling process.py .
ENTRYPOINT ["uv", "run", "--frozen", "process.py"]
